<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo Mail Message mit Bild -->
        <record id="demo_mail_message_with_image" model="mail.message">
            <field name="model">discuss.channel</field>
            <field name="res_id" ref="mail.channel_all_employees"/>
            <field name="body">
                <![CDATA[
                    <p>Willkommen zur Demo-Nachricht!</p>
                    <img src="https://bytist.de/web/image/website/1/logo/Bytist" alt="Bytist Logo"/>
                    <p>Hier sollten Sie <b>NICHT</b> das Bytist Logo sehen</p>
                ]]>
            </field>
            <field name="subject">Demo-Nachricht mit Bild</field>
            <field name="message_type">comment</field>
            <field name="subtype_id" ref="mail.mt_note"/>
            <field name="author_id" ref="base.user_admin"/>
        </record>
    </data>
</odoo>
